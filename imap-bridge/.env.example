# ===== 必填：在 OneMail「管理中心 → IMAP 服务」打开开关、保存后，复制那里显示的三行 =====
ONEMAIL_URL=https://mail.example.com
IMAP_HOST=imap.example.com
GATEWAY_KEY=

# ===== 证书 =====
# 默认用 Caddy 自动申请证书(需要本机 80、443 端口空闲并能从外网访问)。
# 已经有证书(例如宝塔、nginx、acme.sh 签的)时：删掉下一行，并在下面填证书路径。
COMPOSE_PROFILES=caddy
# 自有证书的路径(容器内路径，见 docker-compose.yml 里的 ./certs 挂载)
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

# ===== 可选 =====
# 143 端口(STARTTLS),填 0 关闭
IMAP_PORT=143
# 客户端 IDLE 时多久检查一次新信(秒)
IDLE_POLL_SECONDS=20
